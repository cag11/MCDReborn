<UserControl x:Class="MCDSaveEdit.UI.CustomItemsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">

    <!-- Slots on the left, the chosen slot's design on the right. The right side scrolls as a
         whole, so the grid never squeezes the pickers above it on a short window. -->
    <Grid Margin="10,6,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Label x:Name="slotsLabel" DockPanel.Dock="Top" Content="*Your items*" Padding="0,0,0,4"/>
            <TextBlock x:Name="slotsHint" DockPanel.Dock="Top" Foreground="Gray" TextWrapping="Wrap" Visibility="Collapsed"
                       FontSize="11" Margin="2,0,2,8"/>

            <!-- New items; the plugin registers them when the game starts. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel x:Name="newButtons" Orientation="Horizontal">
                    <Button x:Name="newMeleeButton" Content="*New melee item*" Padding="8,4" Margin="0,0,6,0"
                            Click="newMeleeButton_Click"/>
                    <Button x:Name="newRangedButton" Content="*New ranged item*" Padding="8,4" Margin="0,0,6,0"
                            Click="newRangedButton_Click"/>
                    <Button x:Name="newArmorButton" Content="*New armour*" Padding="8,4" Margin="0,0,6,0"
                            Click="newArmorButton_Click"/>
                </StackPanel>
                <Button x:Name="newArtifactButton" Content="*New artifact*" Padding="8,4" Margin="0,6,0,0"
                        HorizontalAlignment="Left" Click="newArtifactButton_Click"/>
                <TextBlock x:Name="pluginStatus" Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="2,6,2,0"/>
            </StackPanel>

            <ListBox x:Name="slotList" SelectionChanged="slotList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock x:Name="statusLabel" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="2,8,2,0"
                       FontSize="11"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="2,8,2,0">
                <Button x:Name="installButton" Content="*Save and install*" Padding="10,5" Margin="0,0,6,0"
                        Click="installButton_Click"/>
                <Button x:Name="clearButton" Content="*Empty this slot*" Padding="10,5" Margin="0,0,18,0"
                        Click="clearButton_Click"/>
                <Button x:Name="exportButton" Content="*Export…*" Padding="10,5" Margin="0,0,6,0"
                        Click="exportButton_Click"/>
                <Button x:Name="importButton" Content="*Import…*" Padding="10,5"
                        Click="importButton_Click"/>
            </StackPanel>

            <ScrollViewer x:Name="editor" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock x:Name="slotTitle" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="slotDetail" Foreground="Gray" FontSize="11" Margin="0,2,0,10"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="pluginNote" Foreground="Gray" FontSize="11" Margin="0,-6,0,10"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- What the game calls it. -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="nameLabel" VerticalAlignment="Center"/>
                        <TextBox x:Name="nameBox" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                                 TextChanged="text_Changed"/>
                        <TextBlock x:Name="descriptionLabel" Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0"/>
                        <TextBox x:Name="descriptionBox" Grid.Row="1" Grid.Column="1" Height="52" Margin="0,6,0,0"
                                 TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                                 TextChanged="text_Changed"/>
                    </Grid>
                    <TextBlock x:Name="textHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="90,0,2,10"/>

                    <!-- What it is a copy of. -->
                    <Label x:Name="copyLabel" Content="*Copy from*" Padding="0,0,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <TextBox x:Name="searchBox" Height="26" VerticalContentAlignment="Center"
                                 TextChanged="searchBox_TextChanged"/>
                        <TextBlock x:Name="searchHint" Text="Search…" Margin="9,0,0,0" Foreground="Gray"
                                   IsHitTestVisible="False" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox x:Name="sourceList" Height="170" SelectionChanged="sourceList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Its picture. -->
                    <Label x:Name="iconLabel" Content="*Icon*" Padding="0,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <RadioButton x:Name="iconCopied" GroupName="icon" Content="*Keep*" Margin="0,0,0,4"
                                         Checked="icon_Checked"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <RadioButton x:Name="iconOther" GroupName="icon" Content="*Another item's*"
                                             VerticalAlignment="Center" Checked="icon_Checked"/>
                                <ComboBox x:Name="iconItemBox" Width="260" Margin="10,0,0,0" IsEditable="True"
                                          IsTextSearchEnabled="True" SelectionChanged="iconItemBox_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="iconImage" GroupName="icon" Content="*My picture*"
                                             VerticalAlignment="Center" Checked="icon_Checked"/>
                                <Button x:Name="chooseImageButton" Content="*Choose picture…*" Padding="8,3"
                                        Margin="10,0,0,0" Click="chooseImageButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="96" Height="96" Background="#11FFFFFF" CornerRadius="3">
                            <Image x:Name="iconPreview" Stretch="Uniform" Margin="4"/>
                        </Border>
                    </Grid>

                    <!-- What it has built in: melee only, the one type read and tried. -->
                    <StackPanel x:Name="traitsPanel" Visibility="Collapsed">
                        <Label x:Name="skillsLabel" Content="*Skills*" Padding="0,12,0,2"/>
                        <TextBlock x:Name="skillsHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,6"/>
                        <StackPanel x:Name="skillsList" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ComboBox x:Name="addSkillBox" Width="260" IsEditable="True" IsTextSearchEnabled="True"/>
                            <Button x:Name="addSkillButton" Content="*Add*" Padding="8,2" Margin="6,0,0,0" Click="addSkillButton_Click"/>
                            <Button x:Name="traitsResetButton" Content="*Use the copied weapon's*" Padding="8,2" Margin="12,0,0,0"
                                    Click="traitsResetButton_Click"/>
                        </StackPanel>
                        <Label x:Name="linesLabel" Content="*Property lines*" Padding="0,10,0,2"/>
                        <TextBlock x:Name="linesHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,6"/>
                        <WrapPanel x:Name="linesPanel" Margin="0,0,0,4"/>
                    </StackPanel>

                    <!-- What it does. -->
                    <Label x:Name="behaviourLabel" Content="*Behaviour*" Padding="0,12,0,2"/>
                    <TextBlock x:Name="behaviourHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                               Margin="2,0,2,6"/>
                    <WrapPanel x:Name="multipliers" Margin="0,0,0,6">
                        <TextBlock x:Name="allSwingsLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="damageXLabel" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="damageXBox" Width="46" Text="1" Margin="0,0,10,0"/>
                        <TextBlock x:Name="speedXLabel" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="speedXBox" Width="46" Text="1" Margin="0,0,10,0"/>
                        <TextBlock x:Name="reachXLabel" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="reachXBox" Width="46" Text="1" Margin="0,0,10,0"/>
                        <Button x:Name="applyButton" Content="*Apply*" Padding="8,2" Margin="0,0,6,0"
                                Click="applyButton_Click"/>
                        <Button x:Name="resetButton" Content="*Game values*" Padding="8,2" Margin="0,0,12,0"
                                Click="resetButton_Click"/>
                        <CheckBox x:Name="showAllBox" VerticalAlignment="Center" Checked="showAllBox_Changed"
                                  Unchecked="showAllBox_Changed"/>
                    </WrapPanel>
                    <DataGrid x:Name="behaviourGrid" Height="280" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CellEditEnding="behaviourGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="swingColumn" Header="Swing" Binding="{Binding Swing}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn x:Name="settingColumn" Header="Setting" Binding="{Binding Setting}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn x:Name="gameColumn" Header="Game" Binding="{Binding Game}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn x:Name="yoursColumn" Header="Yours" Binding="{Binding Yours, UpdateSourceTrigger=LostFocus}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
