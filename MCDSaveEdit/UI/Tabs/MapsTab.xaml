<UserControl x:Class="MCDSaveEdit.UI.MapsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MCDSaveEdit.UI"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="900">

    <!-- Same shape as the Music tab, for the same reason: one column, and every row that is not
         the list has a fixed height, so nothing moves when you click a different mission.

         The rows are declared bottom-up because DockPanel puts the first one it is given
         furthest out - status is written first and lands lowest. -->
    <DockPanel Margin="10,6,10,10">

        <Label x:Name="missionsLabel" DockPanel.Dock="Top" Content="*Missions*" Padding="0,0,0,4"/>

        <TextBlock x:Name="missionsHint" DockPanel.Dock="Top" Foreground="Gray" TextWrapping="Wrap"
                   FontSize="11" Margin="2,0,2,8"/>

        <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
            <TextBox x:Name="searchBox" Height="26" VerticalContentAlignment="Center"
                     TextChanged="searchBox_TextChanged"/>
            <TextBlock x:Name="searchHint" Text="Search…" Margin="9,0,0,0" Foreground="Gray"
                       IsHitTestVisible="False" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="statusLabel" DockPanel.Dock="Bottom" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" Margin="2,8,2,0" FontSize="11" Height="18"/>

<!--
             Docked bottom-first, so these read upward: the row declared first sits lowest.
             Visually that gives First, then Terrain, then Mobs, then Undo, then the status line.

             Laid out as two workflows rather than a row of six buttons, because that is what they
             are. Terrain goes out to Minecraft and comes back; mobs and spawns never leave the
             app. They share only the first step. Nobody could tell that from a row of buttons.
        -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="2,6,2,0">
            <TextBlock x:Name="undoLabel" VerticalAlignment="Center" Width="110"
                       FontWeight="SemiBold" FontSize="11"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <Button x:Name="clearButton" Content="*Clear*" Padding="10,5" Margin="0,0,6,0"
                    Click="clearButton_Click"/>
            <Button x:Name="removeButton" Content="*Remove*" Padding="10,5"
                    Click="removeButton_Click"/>
            <TextBlock x:Name="undoWhyLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="importedLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="2,8,2,0">
            <TextBlock x:Name="spawnsGroupLabel" VerticalAlignment="Center" Width="110"
                       FontWeight="SemiBold" FontSize="11"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <Button x:Name="exportButton" Content="*Export map*" Padding="10,5" Margin="0,0,6,0"
                    Click="exportButton_Click"/>
            <Button x:Name="spawnsButton" Content="*Edit spawns…*" Padding="10,5"
                    Click="spawnsButton_Click"/>
            <TextBlock x:Name="spawnsWhyLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="2,8,2,0">
            <TextBlock x:Name="terrainGroupLabel" VerticalAlignment="Center" Width="110"
                       FontWeight="SemiBold" FontSize="11"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <Button x:Name="fixedToMinecraftButton" Content="*Edit in Minecraft…*" Padding="10,5"
                    Margin="0,0,6,0" Click="fixedToMinecraftButton_Click"/>
            <Button x:Name="fromMinecraftButton" Content="*Bring back…*" Padding="10,5"
                    Margin="0,0,6,0" Click="fromMinecraftButton_Click"/>
            <Button x:Name="importButton" Content="*Import map…*" Padding="10,5"
                    Click="importButton_Click"/>
            <TextBlock x:Name="toolsLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
        </StackPanel>



        <Border DockPanel.Dock="Bottom" Margin="2,8,2,0" Padding="8,5"
                Background="#11FFFFFF" CornerRadius="3" Height="44">
            <StackPanel>
                <TextBlock x:Name="chosenLabel" FontWeight="SemiBold" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="chosenDetail" Foreground="Gray" FontSize="11"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- What is already replaced. A reminder, not a workspace. -->
        <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="72" VerticalScrollBarVisibility="Auto"
                      Margin="2,8,2,0">
            <StackPanel x:Name="installedStack"/>
        </ScrollViewer>

        <ListBox x:Name="missionList" BorderThickness="0" Background="Transparent"
                 SelectionChanged="missionList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>
</UserControl>
