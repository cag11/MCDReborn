<UserControl x:Class="MCDSaveEdit.UI.MusicTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MCDSaveEdit.UI"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="900">
    <Grid Margin="10,6,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- The game's music, longest first. Length is what tells a track from a sting: everything
             here is called bgm_ and most of it is one bar of something. -->
        <DockPanel Grid.Column="0">
            <Label x:Name="tracksLabel" DockPanel.Dock="Top" Content="*Game music*" Padding="0,0,0,4"/>

            <TextBlock x:Name="tracksHint" DockPanel.Dock="Top" Foreground="Gray" TextWrapping="Wrap"
                       FontSize="11" Margin="2,0,2,6"/>

            <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                <TextBox x:Name="searchBox" Height="26" VerticalContentAlignment="Center"
                         TextChanged="searchBox_TextChanged"/>
                <TextBlock x:Name="searchHint" Text="Search…" Margin="9,0,0,0" Foreground="Gray"
                           IsHitTestVisible="False" VerticalAlignment="Center"/>
            </Grid>

            <ListBox x:Name="trackList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="trackList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <Label x:Name="replaceLabel" DockPanel.Dock="Top" Content="*Replace with your own*"
                   Padding="0,0,0,4"/>

            <TextBlock x:Name="hintLabel" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray"
                       FontSize="11" Margin="2,0,2,10"/>

            <Border x:Name="chosenStrip" DockPanel.Dock="Top" Margin="2,0,2,10" Padding="8,6"
                    Background="#11FFFFFF" CornerRadius="3">
                <StackPanel>
                    <TextBlock x:Name="chosenTrackLabel" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock x:Name="chosenTrackDetail" TextWrapping="Wrap" Foreground="Gray"
                               FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,10">
                <Button x:Name="pickButton" Content="*Choose MP3…*" Padding="10,5" Margin="0,0,6,0"
                        Click="pickButton_Click"/>
                <Button x:Name="installButton" Content="*Install*" Padding="10,5" Margin="0,0,6,0"
                        Click="installButton_Click"/>
                <Button x:Name="removeButton" Content="*Remove*" Padding="10,5"
                        Click="removeButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="chosenFileLabel" DockPanel.Dock="Top" TextWrapping="Wrap"
                       Margin="2,0,2,10" FontSize="11"/>

            <TextBlock x:Name="statusLabel" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                       Margin="2,8,2,0" FontSize="11"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="installedStack" Margin="2,0,2,0"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
