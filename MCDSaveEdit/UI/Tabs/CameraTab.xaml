<UserControl x:Class="MCDSaveEdit.UI.CameraTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="640" d:DesignWidth="900">

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ways of looking at the game: three that ship, and whatever has been saved -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <Label x:Name="presetsLabel" DockPanel.Dock="Top" Content="*Presets*" Padding="0,0,0,4"/>
            <TextBlock x:Name="presetsHint" DockPanel.Dock="Top" Foreground="Gray"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- Saving what the sliders have been dragged to -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock x:Name="saveLabel" Foreground="Gray" TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                <DockPanel>
                    <Button x:Name="saveButton" DockPanel.Dock="Right" Content="*Save*"
                            Width="70" Height="26" Margin="6,0,0,0" Click="saveButton_Click"/>
                    <TextBox x:Name="saveName" Height="26" VerticalContentAlignment="Center"
                             KeyDown="saveName_KeyDown"/>
                </DockPanel>
                <Button x:Name="deleteButton" Content="*Delete*" Height="24" Margin="0,6,0,0"
                        HorizontalAlignment="Left" Padding="10,0" Click="deleteButton_Click"/>
            </StackPanel>

            <ListBox x:Name="presetList" SelectionChanged="presetList_SelectionChanged"
                     BorderThickness="0"
                     Background="{DynamicResource Brush.Panel}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <Label x:Name="settingsLabel" DockPanel.Dock="Top" Content="*Camera*" Padding="0,0,0,4"/>

            <!-- The running game, when there is one. Nothing to press to connect: it watches. -->
            <Border x:Name="liveStrip" DockPanel.Dock="Top" Margin="0,0,0,10" Padding="0,0,0,10"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}">
                <StackPanel>
                    <TextBlock x:Name="liveHint" Foreground="Gray" TextWrapping="Wrap"/>

                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="restoreButton" DockPanel.Dock="Right" Content="*Put it back*"
                                Height="26" Padding="10,0" Margin="8,0,0,0"
                                Click="restoreButton_Click"/>
                        <CheckBox x:Name="mouseLook" Content="*Mouse look*" VerticalAlignment="Center"
                                  Checked="mouseLook_Changed" Unchecked="mouseLook_Changed"/>
                    </DockPanel>

                    <CheckBox x:Name="wasd" Content="*Move with WASD*" Margin="0,6,0,0"
                              Checked="wasd_Changed" Unchecked="wasd_Changed"/>
                    <CheckBox x:Name="mouseButtons" Content="*Clicking attacks*" Margin="0,6,0,0"
                              Checked="mouseButtons_Changed" Unchecked="mouseButtons_Changed"/>
                    <CheckBox x:Name="canJump" Content="*Q jumps*" Margin="0,6,0,0"
                              IsChecked="True" Checked="canJump_Changed" Unchecked="canJump_Changed"/>
                    <DockPanel x:Name="jumpRow" Margin="18,4,0,0">
                        <TextBlock x:Name="jumpHeightLabel" DockPanel.Dock="Left" Width="120"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="jumpCountLabel" DockPanel.Dock="Right" Width="90"
                                   TextAlignment="Right" Foreground="Gray" VerticalAlignment="Center"/>
                        <Slider x:Name="jumpHeight" Minimum="600" Maximum="3000" Value="1500"
                                TickFrequency="50" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="jumpHeight_Changed"/>
                    </DockPanel>
                    <DockPanel Margin="18,4,0,0">
                        <TextBlock x:Name="airControlLabel" DockPanel.Dock="Left" Width="120"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="jumpsLabel" DockPanel.Dock="Right" Width="90"
                                   TextAlignment="Right" Foreground="Gray" VerticalAlignment="Center"/>
                        <Slider x:Name="airControl" Minimum="0" Maximum="1" Value="0.35"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="airControl_Changed"/>
                    </DockPanel>
                    <DockPanel Margin="18,4,0,0">
                        <TextBlock x:Name="jumpCountCaption" DockPanel.Dock="Left" Width="120"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="jumpCount" Minimum="1" Maximum="4" Value="1"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="jumpCount_Changed"/>
                    </DockPanel>
                    <CheckBox x:Name="rideKey" Content="*R rides*" Margin="0,10,0,0"
                              IsChecked="True" Checked="rideKey_Changed" Unchecked="rideKey_Changed"/>
                    <DockPanel Margin="18,6,0,0">
                        <TextBlock x:Name="mountSpeedLabel" DockPanel.Dock="Left" Width="120"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="mountSpeedValue" DockPanel.Dock="Right" Width="90"
                                   TextAlignment="Right" Foreground="Gray" VerticalAlignment="Center"/>
                        <Slider x:Name="mountSpeed" Minimum="800" Maximum="6000" Value="2400"
                                TickFrequency="100" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="mountSpeed_Changed"/>
                    </DockPanel>
                    <DockPanel Margin="18,6,0,0">
                        <ContentControl x:Name="sitHeightLabel" DockPanel.Dock="Left" Width="120"
                                        VerticalAlignment="Center"/>
                        <TextBlock x:Name="sitHeightValue" DockPanel.Dock="Right" Width="90"
                                   TextAlignment="Right" Foreground="Gray" VerticalAlignment="Center"/>
                        <Slider x:Name="sitHeight" Minimum="-150" Maximum="600" Value="0"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="sitHeight_Changed"/>
                    </DockPanel>

                    <CheckBox x:Name="canFly" Content="*G flies*" Margin="0,6,0,0"
                              IsChecked="True" Checked="canFly_Changed" Unchecked="canFly_Changed"/>
                    <DockPanel Margin="18,4,0,0">
                        <TextBlock x:Name="flySpeedLabel" DockPanel.Dock="Left" Width="120"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="flySpeedValue" DockPanel.Dock="Right" Width="90"
                                   TextAlignment="Right" Foreground="Gray" VerticalAlignment="Center"/>
                        <Slider x:Name="flySpeed" Minimum="1000" Maximum="12000" Value="4000"
                                TickFrequency="250" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="flySpeed_Changed"/>
                    </DockPanel>

<DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="sensitivityLabel" DockPanel.Dock="Left" Width="120"
                                   VerticalAlignment="Center"/>
                        <CheckBox x:Name="invertPitch" DockPanel.Dock="Right" Content="*Invert*"
                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                  Checked="invertPitch_Changed" Unchecked="invertPitch_Changed"/>
                        <Slider x:Name="sensitivity" Minimum="0.1" Maximum="4" Value="1"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="statusLabel" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="Gray"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="settingStack"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
