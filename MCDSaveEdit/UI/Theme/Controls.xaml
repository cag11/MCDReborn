<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:MCDSaveEdit.UI.Theme">

    <!--
        Implicit styles: TargetType and no x:Key, so they apply app-wide as soon as this
        dictionary is merged. None of the existing views had to change to pick them up.

        Every palette colour is referenced with DynamicResource, never StaticResource.
        That is what lets ThemeManager swap Palette.Dark for Palette.Light on a running app
        and have each control repaint in place.

        The shapes follow Windows 11's Fluent design, drawn in the palette's colours rather
        than Windows' own: 4px corners on controls and 8px on anything floating above the page,
        hover shown as a soft wash rather than an outline, checked boxes filled with the accent,
        a pill under the selected tab and beside the selected list row, thin scrollbars that
        widen under the pointer, and shadows under menus and drop-downs.

        The built-in Fluent theme of .NET 9+ (Application.ThemeMode) was not used. It brings
        Windows' accent colour with it, which would flatten Nether, End and Frost into one blue,
        and its controls are taller and padded wider, which the fixed-size item tiles and
        currency fields here were not laid out for.

        The wash is the palette's own text colour at a few percent: it lightens a dark palette
        and darkens a light one, so no palette needs a key for it.
    -->

    <!-- Windows 11's own typeface, and Segoe UI - WPF's default - where it is missing.
         ThemeManager puts it on every window; tooltips and right-click menus are windows of
         their own and take it here. -->
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>

    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Overlay">8</CornerRadius>


    <!-- ===================== Text ===================== -->

    <!--
        Deliberately no Foreground setter here. Label renders its content through an
        internally generated TextBlock, and an explicit style setter on that TextBlock beats
        the Foreground the Label inherits from its own style - which silently defeated every
        Label that sets a colour, the amber section headings included.
        Colour comes from an ancestor instead and is inherited, so any control that sets its
        own Foreground still wins. Note that the Window's own Foreground does NOT reach into
        a tab's content - the TabItem style below sets it for that - so a TextBlock outside
        any tab and outside a window that sets one will render black.
    -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Hyperlink is an Inline rather than a Control, but implicit styles still reach it.
        Left alone it keeps WPF's hardcoded blue, which fights both palettes.
    -->
    <Style TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="TextDecorations" Value="Underline"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentBright}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Opt-in: the amber all-caps headings the game uses over each panel. -->
    <Style x:Key="SectionHeading" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Padding"    Value="2,4"/>
    </Style>

    <!-- The keyboard focus ring, drawn outside the control as Windows 11 does. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" CornerRadius="6"
                            BorderBrush="{DynamicResource Brush.Select}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Button ===================== -->

    <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground"      Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.Panel}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Deliberately no Padding setter. Several buttons host a fixed-size
             ItemControl whose labels use absolute pixel margins tuned for 100x100;
             adding padding shrinks the content area and clips the power number. -->
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!--
                        The fill sits on its own Border so a caller that sets
                        Background="{x:Null}" - as the pak-icon filter buttons do - still
                        gets the hover wash without a plate behind the icon.
                        Transparent, not null, so the button stays hit-testable.
                    -->
                    <Grid>
                        <Border x:Name="plate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="wash" CornerRadius="{StaticResource Radius.Control}"
                                Background="{DynamicResource Brush.Text}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="press" CornerRadius="{StaticResource Radius.Control}"
                                Background="{DynamicResource Brush.Ground}" Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="content"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True"/>
                        <!--
                            Separate overlay for the outline. Several buttons set
                            BorderBrush="{x:Null}" in markup - the item preview slot and the
                            pak-icon filters - and a local value beats any style setter. Those
                            are the item tiles, which keep the game's own amber frame on hover:
                            a wash alone is too quiet over a picture.
                        -->
                        <Border x:Name="outline" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                                BorderBrush="Transparent" IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Background" Value="{x:Null}"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="outline" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="press" Property="Opacity" Value="0.18"/>
                            <Setter TargetName="content" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="Background" Value="{x:Null}"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="outline" Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter TargetName="plate" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opt-in: the green call to action, as on the game's TRANSFER TO INVENTORY button. -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="{DynamicResource Brush.Positive}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PositiveBright}"/>
        <Setter Property="Foreground"  Value="#FFFFFFFF"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
    </Style>

    <!--
        RepeatButton was never styled, so the Stepper's up/down arrows kept WPF's default
        chrome and read as pale boxes against the dark ground. Scrollbar track buttons use
        their own keyed style and are unaffected by this.
    -->
    <Style TargetType="{x:Type RepeatButton}">
        <Setter Property="Foreground"      Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.Panel}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid>
                        <Border x:Name="plate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"/>
                        <Border x:Name="wash" CornerRadius="{StaticResource Radius.Control}"
                                Background="{DynamicResource Brush.Text}" Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="wash" Property="Opacity" Value="0.08"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.Field}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TextBox ===================== -->

    <!--
        Fluent's text field: a quiet border all round and a line along the bottom that turns
        into a thicker accent bar while typing.
    -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Foreground"      Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.Field}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- No Padding setter either: the currency fields are fixed-width. -->
        <Setter Property="CaretBrush"      Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource Brush.Select}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="plate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"/>
                        <Border x:Name="wash" CornerRadius="{StaticResource Radius.Control}"
                                Background="{DynamicResource Brush.Text}" Opacity="0" IsHitTestVisible="False"/>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                        <Border x:Name="rail" Height="1" Margin="1,0" VerticalAlignment="Bottom"
                                Background="{DynamicResource Brush.BorderStrong}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="wash" Property="Opacity" Value="0.04"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="wash" Property="Opacity" Value="0"/>
                            <Setter TargetName="rail" Property="Height" Value="2"/>
                            <Setter TargetName="rail" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter TargetName="rail" Property="Background" Value="{DynamicResource Brush.Border}"/>
                        </Trigger>
                        <!-- A borderless box - the editable drop-down's, read-only displays - is
                             text on the page, not a field, so it gets no underline either. -->
                        <Trigger Property="BorderThickness" Value="0">
                            <Setter TargetName="rail" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="wash" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CheckBox ===================== -->

    <!-- Fluent's check box: filled with the accent when ticked, the tick in the ground colour. -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18"
                                Background="{DynamicResource Brush.Field}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Grid>
                                <Path x:Name="tick" Data="M 3.5,8.5 L 6.5,11.5 L 12.5,4.5"
                                      Stroke="{DynamicResource Brush.Ground}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                                <Border x:Name="dash" Width="8" Height="2" CornerRadius="1"
                                        Background="{DynamicResource Brush.Ground}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Background"  Value="{DynamicResource Brush.PanelHover}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="box"  Property="Background"  Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="box"  Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="dash" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="box"  Property="Background"  Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="box"  Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="box" Property="Background"  Value="{DynamicResource Brush.AccentBright}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="box" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter TargetName="box" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== RadioButton ===================== -->

    <!-- The CheckBox's twin, round: Fluent's accent ring with a dot in the ground colour,
         which grows a little under the pointer. Without a style WPF's default draws black
         text on the dark palettes - first noticed on the New Items tab. -->
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="ring" Width="18" Height="18"
                                Background="{DynamicResource Brush.Field}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                BorderThickness="1" CornerRadius="9"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource Brush.Ground}"
                                     Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Background"  Value="{DynamicResource Brush.PanelHover}"/>
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot"  Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ring" Property="Background"  Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="dot" Property="Width"  Value="10"/>
                            <Setter TargetName="dot" Property="Height" Value="10"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter TargetName="ring" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slider ===================== -->

    <!--
        Never styled before, so every slider kept Windows' blue track and grey thumb. Fluent's:
        a thin rounded track, the part up to the value in the accent, and a round thumb with an
        accent centre that grows under the pointer. Horizontal only - no slider here stands up.
    -->
    <Style x:Key="SliderFill" TargetType="{x:Type RepeatButton}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Width="20" Height="20">
                        <Ellipse Fill="{DynamicResource Brush.Popup}" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1"/>
                        <Ellipse x:Name="core" Width="10" Height="10" Fill="{DynamicResource Brush.Accent}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="core" Property="Width"  Value="13"/>
                            <Setter TargetName="core" Property="Height" Value="13"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="core" Property="Width"  Value="8"/>
                            <Setter TargetName="core" Property="Height" Value="8"/>
                            <Setter TargetName="core" Property="Fill" Value="{DynamicResource Brush.AccentBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Margin="10,0" Background="{DynamicResource Brush.BorderStrong}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Background="{DynamicResource Brush.Accent}"
                                              Command="Slider.DecreaseLarge" Margin="10,0,-10,0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Background="Transparent"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== DataGrid ===================== -->

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background"                Value="{DynamicResource Brush.Field}"/>
        <Setter Property="Foreground"                Value="{DynamicResource Brush.Text}"/>
        <Setter Property="BorderBrush"               Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness"           Value="1"/>
        <Setter Property="RowBackground"             Value="Transparent"/>
        <Setter Property="AlternatingRowBackground"  Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="HorizontalGridLinesBrush"  Value="{DynamicResource Brush.Border}"/>
        <Setter Property="VerticalGridLinesBrush"    Value="{DynamicResource Brush.Border}"/>
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background"      Value="{DynamicResource Brush.Panel}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding"         Value="6,4"/>
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentBright}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Scrolling ===================== -->

    <!--
        Thin until the pointer is over the bar, then wide enough to grab, as in Windows 11.
        The bar keeps its full 12px either way, so nothing beside it moves.
    -->
    <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="bar" Background="{DynamicResource Brush.Thumb}" CornerRadius="3" Margin="4.5"/>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="True">
                            <Setter TargetName="bar" Property="Margin" Value="3"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bar" Property="Background" Value="{DynamicResource Brush.ThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="bar" Property="Background" Value="{DynamicResource Brush.ThumbHover}"/>
                            <Setter TargetName="bar" Property="Margin" Value="3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The track buttons exist for paging but should not be drawn. -->
    <Style x:Key="ScrollTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width"      Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width"  Value="Auto"/>
                            <Setter Property="Height" Value="12"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ComboBox ===================== -->

    <Style x:Key="ComboToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Border x:Name="plate"
                                Background="{DynamicResource Brush.Field}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"/>
                        <Border x:Name="wash" CornerRadius="{StaticResource Radius.Control}"
                                Background="{DynamicResource Brush.Text}" Opacity="0"/>
                        <!-- Fluent's chevron, drawn as a stroke rather than a filled triangle. -->
                        <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,1,10,0" Data="M 0,0 L 4.5,4.5 L 9,0"
                              Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="wash"  Property="Opacity" Value="0.06"/>
                            <Setter TargetName="plate" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                            <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Field}"/>
        <Setter Property="Padding"    Value="6,2"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="selection" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                        <!-- An editable box shows its selection as text in here rather than through
                             SelectionBoxItem, which WPF leaves empty for it - so with this collapsed,
                             an editable box looked blank whatever was picked. Clear of the arrow. -->
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                 Margin="2,0,24,0" Padding="2,0" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{DynamicResource Brush.Text}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <!-- The margin is room for the shadow; the offset puts the visible edge
                             back under the box. -->
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade"
                               HorizontalOffset="-10" VerticalOffset="-4">
                            <Grid Margin="10,6,10,14">
                    <Border Background="{DynamicResource Brush.Popup}" CornerRadius="{StaticResource Radius.Overlay}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                              Color="{DynamicResource Color.Shadow}" Opacity="{DynamicResource Value.ShadowOpacity}"/>
                        </Border.Effect>
                    </Border>
                    <Border
                                    Background="{DynamicResource Brush.Popup}"
                                    BorderBrush="{DynamicResource Brush.BorderStrong}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Overlay}" Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                    </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="selection" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row in a drop-down: rounded, and the chosen one marked by Fluent's accent pill. -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Padding"    Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid Margin="0,1">
                        <Border x:Name="plate" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.PanelHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="pill"  Property="Visibility" Value="Visible"/>
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.PanelHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Segmented toggles, as used by the enchantment filter bar. ToggleButton has no style
        of its own otherwise, so it falls back to the default Windows chrome - a grey plate
        on a blue highlight - which looks nothing like the rest of the app.

        Checked is carried by the fill rather than by an outline: these sit in a row where
        several can be on at once, and a row of outlines reads as noise. Fluent fills a checked
        toggle with the accent, which says it even more plainly.
    -->
    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground"      Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.Field}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,4"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Border x:Name="plate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True"/>
                        <Border x:Name="wash" CornerRadius="{StaticResource Radius.Control}"
                                Background="{DynamicResource Brush.Text}" Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="wash"  Property="Opacity" Value="0.08"/>
                            <Setter TargetName="plate" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="Background"  Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="plate" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ground}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="plate" Property="Background"  Value="{DynamicResource Brush.AccentBright}"/>
                            <Setter TargetName="plate" Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                            <Setter TargetName="wash"  Property="Opacity" Value="0"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="plate" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter TargetName="plate" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Menu ===================== -->

    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource Brush.Menu}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <!-- Across only: the main window's menu bar is a fixed 30px tall. -->
        <Setter Property="Padding"    Value="4,0"/>
    </Style>

    <!--
        Right-click menus are their own control, not a Menu, so they need their own chrome -
        without this they render as a white popup over a dark app. The items inside are
        MenuItems and already pick up the templates below.
    -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
        <!-- Back by the room left for the shadow, so the menu opens at the pointer. -->
        <Setter Property="HorizontalOffset" Value="-10"/>
        <Setter Property="VerticalOffset" Value="-6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Margin="10,6,10,14">
                    <Border Background="{DynamicResource Brush.Popup}" CornerRadius="{StaticResource Radius.Overlay}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                              Color="{DynamicResource Color.Shadow}" Opacity="{DynamicResource Value.ShadowOpacity}"/>
                        </Border.Effect>
                    </Border>
                    <Border
                            Background="{DynamicResource Brush.Popup}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Overlay}" Padding="4">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="6,4"/>
    </Style>

    <ControlTemplate x:Key="MenuTopLevel" TargetType="{x:Type MenuItem}">
        <Border x:Name="plate" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Margin="1,2">
            <Grid>
                <ContentPresenter ContentSource="Header" Margin="10,3" RecognizesAccessKey="True"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom" PopupAnimation="Fade" HorizontalOffset="-10" VerticalOffset="-2">
                    <Grid Margin="10,6,10,14">
                    <Border Background="{DynamicResource Brush.Popup}" CornerRadius="{StaticResource Radius.Overlay}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                              Color="{DynamicResource Color.Shadow}" Opacity="{DynamicResource Value.ShadowOpacity}"/>
                        </Border.Effect>
                    </Border>
                    <Border
                            Background="{DynamicResource Brush.Popup}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Overlay}" Padding="4">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.PanelHover}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.PanelHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuLeafItem" TargetType="{x:Type MenuItem}">
        <Border x:Name="plate" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Margin="0,1">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="tick" Grid.Column="0" Data="M 2,6 L 5.5,9.5 L 11,3"
                      Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      VerticalAlignment="Center" Visibility="Collapsed"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="24,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.PanelHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuSubHeader" TargetType="{x:Type MenuItem}">
        <Border x:Name="plate" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Margin="0,1">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <Path Grid.Column="2" Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource Brush.TextMuted}"
                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Margin="24,0,0,0" VerticalAlignment="Center"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" HorizontalOffset="-3"
                       VerticalOffset="-12"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Right" PopupAnimation="Fade">
                    <Grid Margin="10,6,10,14">
                    <Border Background="{DynamicResource Brush.Popup}" CornerRadius="{StaticResource Radius.Overlay}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                              Color="{DynamicResource Color.Shadow}" Opacity="{DynamicResource Value.ShadowOpacity}"/>
                        </Border.Effect>
                    </Border>
                    <Border
                            Background="{DynamicResource Brush.Popup}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Overlay}" Padding="4">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.PanelHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Template"   Value="{StaticResource MenuLeafItem}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuTopLevel}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuTopLevel}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuSubHeader}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Tabs ===================== -->

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background"      Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <DockPanel Background="{TemplateBinding Background}">
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource Brush.Menu}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1">
                            <!-- A WrapPanel rather than a TabPanel, which is WPF's own and does
                                 one thing too many: when the headers need more than one row it
                                 re-orders the ROWS so that whichever holds the selected tab sits
                                 against the content. With seven tabs on three rows that means
                                 the whole strip rearranges itself on every click and no tab is
                                 ever twice in the same place.

                                 This is the template every TabControl in the app uses, so
                                 setting ItemsPanel on one of them does nothing - the template
                                 names its own items host and the property is ignored. Single-row
                                 tab strips are unaffected: with room for everything, a WrapPanel
                                 and a TabPanel lay out the same. -->
                            <WrapPanel IsItemsHost="True" Margin="8,4,8,0" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Foreground is set on the header presenter, NOT on the TabItem. WPF inherits a
        TabItem's Foreground into the tab's *content* as well as its header, so colouring the
        selected tab amber turned every label on the page amber with it.
    -->
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!--
            This is what the tab's CONTENT inherits, not the tab header - the header takes its
            colour on the ContentPresenter below, which is why setting this one amber used to
            turn every label on the page amber. Without it, TextBlocks inside a tab that do not
            set a colour of their own render pure black in every theme: the Window's Foreground
            does not reach them.
        -->
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <!-- Fluent's selector bar: a rounded wash under the pointer, and an accent pill
                         under the chosen tab, the game's amber in the Dark palette. -->
                    <Grid Margin="0,0,2,0">
                        <Border x:Name="plate" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Margin="0,0,0,5"/>
                        <ContentPresenter x:Name="header" ContentSource="Header" Margin="14,6,14,11"
                                          RecognizesAccessKey="True"
                                          TextBlock.Foreground="{DynamicResource Brush.TextMuted}"/>
                        <Border x:Name="rail" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="14,0,14,1"
                                Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate"  Property="Background" Value="{DynamicResource Brush.Panel}"/>
                            <Setter TargetName="header" Property="TextBlock.Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="rail"   Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="header" Property="TextBlock.Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.Panel}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="header" Property="TextBlock.Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Side menu ===================== -->

    <!--
        The main window's tabs as Windows 11's navigation pane: icons and names down the left,
        group headings, the chosen page marked by the accent pill, and the entry docked to the
        bottom (Mods) pinned to the foot. Nav.cs decides when it is open and whether it floats
        over the page; this only draws each state.

        Opt-in by key, so the other TabControls in the app keep their strip along the top.
    -->
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="NavItem" TargetType="{x:Type TabItem}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- What the page inherits - see the TabItem style above for why this is here. -->
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="ToolTipService.Placement" Value="Right"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <DockPanel>
                        <!-- The heading: not part of the entry to the pointer, so a click on it
                             chooses nothing. -->
                        <Grid x:Name="heading" DockPanel.Dock="Top" IsHitTestVisible="False">
                            <TextBlock x:Name="headingText" Margin="16,14,8,4" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                                       Text="{Binding (theme:Nav.Group), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border x:Name="headingLine" Height="1" Margin="10,4" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Border}" Visibility="Collapsed"/>
                        </Grid>
                        <Grid x:Name="row" Height="36" Margin="4,1" Background="Transparent">
                            <Border x:Name="plate" CornerRadius="{StaticResource Radius.Control}" Background="Transparent"/>
                            <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Background="Transparent"/>
                            <TextBlock x:Name="icon" Width="40" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       TextAlignment="Center" FontSize="16" FontFamily="{StaticResource Font.Icons}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Text="{Binding (theme:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="header" ContentSource="Header" Margin="44,0,8,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextBlock.Foreground="{DynamicResource Brush.TextMuted}"/>
                        </Grid>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="theme:Nav.Group" Value="{x:Null}">
                            <Setter TargetName="heading" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="theme:Nav.Group" Value="">
                            <Setter TargetName="headingText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="headingLine" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Shut: icons only, and a line where each heading was. -->
                        <Trigger Property="theme:Nav.IsOpen" Value="False">
                            <Setter TargetName="header" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="headingText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="headingLine" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate"  Property="Background" Value="{DynamicResource Brush.Panel}"/>
                            <Setter TargetName="icon"   Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            <Setter TargetName="header" Property="TextBlock.Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="plate"  Property="Background" Value="{DynamicResource Brush.Panel}"/>
                            <Setter TargetName="pill"   Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="icon"   Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="header" Property="TextBlock.Foreground" Value="{DynamicResource Brush.Text}"/>
                            <Setter TargetName="header" Property="TextBlock.FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="plate" Property="BorderBrush" Value="{DynamicResource Brush.Select}"/>
                            <Setter TargetName="plate" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="icon"   Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter TargetName="header" Property="TextBlock.Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- With the names hidden, the name is what the pointer shows. -->
            <Trigger Property="theme:Nav.IsOpen" Value="False">
                <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The menu button at the head of the menu. -->
    <Style x:Key="NavToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="plate" Width="40" Height="36" Margin="4,6,4,2" HorizontalAlignment="Left"
                            CornerRadius="{StaticResource Radius.Control}" Background="Transparent">
                        <TextBlock x:Name="glyph" Text="&#xE700;" FontFamily="{StaticResource Font.Icons}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.Panel}"/>
                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="plate" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Background"      Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <!--
                        The spacer holds the page's left edge: the icon strip's width when the
                        menu is shut or floating, the full menu's when it stands open. The menu
                        itself spans both columns, so when it floats it lies over the page.
                    -->
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="spacer" Grid.Column="0" Width="48"/>
                        <Border Grid.Column="1">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                        <Grid x:Name="rail" Grid.Column="0" Grid.ColumnSpan="2" Width="48" HorizontalAlignment="Left"
                              Panel.ZIndex="1">
                            <Border x:Name="shadow" Background="{DynamicResource Brush.Menu}" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                                                      Color="{DynamicResource Color.Shadow}" Opacity="{DynamicResource Value.ShadowOpacity}"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="{DynamicResource Brush.Menu}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Top" Style="{StaticResource NavToggle}"
                                                  IsChecked="{Binding (theme:Nav.IsOpen), Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ScrollViewer x:Name="railScroll" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <!-- At least as tall as the menu, so the last entry can sit at its foot. -->
                                        <DockPanel IsItemsHost="True" LastChildFill="False"
                                                   MinHeight="{Binding ViewportHeight, ElementName=railScroll}"
                                                   KeyboardNavigation.TabIndex="1"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="theme:Nav.IsOpen" Value="True">
                            <Setter TargetName="rail"   Property="Width" Value="220"/>
                            <Setter TargetName="spacer" Property="Width" Value="220"/>
                        </Trigger>
                        <!-- The icon strip is too narrow to give a scrollbar room; the wheel
                             still scrolls it on a short window. -->
                        <Trigger Property="theme:Nav.IsOpen" Value="False">
                            <Setter TargetName="railScroll" Property="VerticalScrollBarVisibility" Value="Hidden"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="theme:Nav.IsOpen" Value="True"/>
                                <Condition Property="theme:Nav.IsOverlay" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="spacer" Property="Width" Value="48"/>
                            <Setter TargetName="shadow" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Containers ===================== -->

    <!-- A Fluent card: the panel colour, a hairline edge, 8px corners. -->
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground"  Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Background"  Value="{DynamicResource Brush.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Overlay}" Padding="12">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" ContentSource="Header"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A template of our own at last. Without one, a DISABLED list fell back to Windows'
        white plate - the New Items tab's "Copy from" list sat as a white box until an item was
        picked. The same 1px inset as Windows' own template, so no list loses a column of tiles.
    -->
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background"      Value="{DynamicResource Brush.Panel}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.Text}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border x:Name="plate"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="1"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="plate" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsGrouping" Value="True"/>
                                <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A list row: rounded, a wash under the pointer, and the chosen one marked by the pill. -->
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Padding"    Value="8,5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                        <Border x:Name="plate" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="pill" Width="3" CornerRadius="1.5" HorizontalAlignment="Left"
                                Margin="0,8" MaxHeight="18" Background="{DynamicResource Brush.Accent}"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.PanelHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource Brush.PanelHover}"/>
                            <Setter TargetName="pill"  Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background"      Value="{DynamicResource Brush.Popup}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.Text}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,6"/>
        <Setter Property="HasDropShadow"   Value="False"/>
        <Setter Property="FontFamily"      Value="{DynamicResource Font.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Grid Margin="8,4,8,12">
                    <Border Background="{DynamicResource Brush.Popup}" CornerRadius="{StaticResource Radius.Control}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                              Color="{DynamicResource Color.Shadow}" Opacity="{DynamicResource Value.ShadowOpacity}"/>
                        </Border.Effect>
                    </Border>
                    <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
