<Window x:Class="MCDSaveEdit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCDSaveEdit.UI"
        xmlns:theme="clr-namespace:MCDSaveEdit.UI.Theme"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        MinHeight="490" MinWidth="1200"
        Title="*Minecraft Dungeons Save File Editor*"
        Background="{DynamicResource Brush.Ground}"
        Foreground="{DynamicResource Brush.Text}"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="exitCommandBinding_Executed"/>
        <CommandBinding Command="Open" Executed="openCommandBinding_Executed"/>
        <CommandBinding Command="Save" Executed="saveCommandBinding_Executed"/>
        <CommandBinding Command="SaveAs" Executed="saveAsCommandBinding_Executed"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="Open"/>
        <KeyBinding Key="S" Modifiers="Control" Command="Save"/>
        <KeyBinding Key="Q" Modifiers="Control" Command="Close"/>
    </Window.InputBindings>
    <DockPanel AllowDrop="True" Drop="window_File_Drop" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

        <Menu DockPanel.Dock="Top" Width="Auto" Height="30" Margin="0" VerticalAlignment="Top">
            <MenuItem x:Name="fileMenuItem" Header="_File">
                <MenuItem x:Name="openMenuItem" Header="_Open..." Command="Open" InputGestureText="Ctrl+O" />
                <MenuItem x:Name="saveMenuItem" Header="_Save" Command="Save" InputGestureText="Ctrl+S" />
                <MenuItem x:Name="saveAsMenuItem" Header="Save _As..." Command="SaveAs"/>
                <Separator />
                <MenuItem x:Name="recentFilesMenuItem" Header="_Recent Files"/>
                <Separator />
                <MenuItem x:Name="exitMenuItem" Header="_Exit" Command="Close" InputGestureText="Ctrl+Q" />
            </MenuItem>
            <MenuItem Header="_Game Paks">
                <MenuItem x:Name="gameFilesVersionMenuItem" Header="Unknown Game Version" IsEnabled="false" />
                <MenuItem x:Name="gameFilesLocationMenuItem" Header="No Game Files" IsEnabled="false" />
                <Separator/>
                <MenuItem x:Name="relaunchToChangeMenuItem" Header="Relaunch to change..." Click="relaunchMenuItem_Click"/>
            </MenuItem>
            <MenuItem x:Name="langMenuItem" Header="_Language">
                <MenuItem x:Name="noneLangMenuItem" Header="None" IsChecked="true"/>
                <Separator/>
            </MenuItem>
            <MenuItem x:Name="buildMenuItem" Header="_Build">
                <MenuItem x:Name="openInBuilderMenuItem" Header="_Open in MCD Builder" Click="openInBuilderMenuItem_Click"/>
                <MenuItem x:Name="copyBuildJsonMenuItem" Header="_Copy Build JSON" Click="copyBuildJsonMenuItem_Click"/>
                <Separator/>
                <MenuItem x:Name="importBuildMenuItem" Header="_Import Build from Clipboard" Click="importBuildMenuItem_Click"/>
                <MenuItem x:Name="importEquipBuildMenuItem" Header="Import _and Equip from Clipboard" Click="importEquipBuildMenuItem_Click"/>
            </MenuItem>
            <MenuItem x:Name="viewMenuItem" Header="_View"/>
            <MenuItem x:Name="aboutMenuItem" Header="_About" Click="aboutMenuItem_Click"/>
            <MenuItem x:Name="updateMenuItem" Header="_Get New Version" Visibility="Collapsed" Click="updateMenuItem_Click"/>
        </Menu>

        <!-- Which save, whether the game is running, what the plugin holds, which game. -->
        <local:AppStatus x:Name="appStatus" DockPanel.Dock="Bottom"/>

        <Grid>
        <!--
            The pages, as a side menu (Controls.xaml's NavTabControl, Nav.cs): what edits the
            save, what makes things for the game, what changes the game while it runs, and the
            mods at the foot. The group headings are set with the names, in translateStaticStrings.
        -->
        <TabControl x:Name="mainTabControl" Style="{StaticResource NavTabControl}">
            <!-- Save file -->
            <TabItem x:Name="inventoryTabItem" theme:Nav.Icon="&#xE80A;" Header="*Inventory*" Selector.Selected="OnTabSelected">
                <local:InventoryTab x:Name="inventoryTab"/>
            </TabItem>

            <TabItem x:Name="chestTabItem" theme:Nav.Icon="&#xE7B8;" Header="*Chest*" Selector.Selected="OnTabSelected">
                <local:ChestTab x:Name="chestTab"/>
            </TabItem>

            <TabItem x:Name="towerTabItem" theme:Nav.Icon="&#xE81E;" Header="*Tower*" Selector.Selected="OnTabSelected">
                <local:TowerTab x:Name="towerTab"/>
            </TabItem>

            <!-- Create -->
            <TabItem x:Name="customItemsTabItem" theme:Nav.Icon="&#xE719;" Header="*New Items*" Selector.Selected="OnTabSelected">
                <local:CustomItemsTab x:Name="customItemsTab"/>
            </TabItem>

            <TabItem x:Name="weaponSkinsTabItem" theme:Nav.Icon="&#xF158;" Header="*Weapon Import*" Selector.Selected="OnTabSelected">
                <local:MeshWorkshopTab x:Name="weaponSkinsTab" Catalogue="Weapons"/>
            </TabItem>

            <TabItem x:Name="mobSkinsTabItem" theme:Nav.Icon="&#xEBE8;" Header="*Mob Import*" Selector.Selected="OnTabSelected">
                <local:MeshWorkshopTab x:Name="mobSkinsTab" Catalogue="Mobs"/>
            </TabItem>

            <TabItem x:Name="mapsTabItem" theme:Nav.Icon="&#xE707;" Header="*Maps*" Selector.Selected="OnTabSelected">
                <local:MapsTab x:Name="mapsTab"/>
            </TabItem>

            <TabItem x:Name="musicTabItem" theme:Nav.Icon="&#xE8D6;" Header="*Music*" Selector.Selected="OnTabSelected">
                <local:MusicTab x:Name="musicTab"/>
            </TabItem>

            <TabItem x:Name="heroTabItem" theme:Nav.Icon="&#xE77B;" Header="*Custom Skins*" Selector.Selected="OnTabSelected">
                <local:HeroSkinTab x:Name="heroTab"/>
            </TabItem>

            <TabItem x:Name="customSkinsTabItem" theme:Nav.Icon="&#xE790;" Header="*Recolor Gear*" Selector.Selected="OnTabSelected">
                <local:CustomSkinsTab x:Name="customSkinsTab"/>
            </TabItem>

            <!-- Live game -->
            <TabItem x:Name="cameraTabItem" theme:Nav.Icon="&#xE722;" Header="*Camera*" Selector.Selected="OnTabSelected">
                <local:CameraTab x:Name="cameraTab"/>
            </TabItem>

            <TabItem x:Name="enemiesTabItem" theme:Nav.Icon="&#xEC4A;" Header="*Enemies*" Selector.Selected="OnTabSelected">
                <local:EnemiesTab x:Name="enemiesTab"/>
            </TabItem>

            <TabItem x:Name="modsTabItem" theme:Nav.Icon="&#xEA86;" DockPanel.Dock="Bottom" Header="*Installed Mods*" Selector.Selected="OnTabSelected">
                <local:ModsTab x:Name="modsTab"/>
            </TabItem>

        </TabControl>

        <!-- Notices, over the page's lower right corner. -->
        <local:NoticeHost x:Name="noticeHost" Panel.ZIndex="5"/>
        </Grid>

    </DockPanel>
</Window>
