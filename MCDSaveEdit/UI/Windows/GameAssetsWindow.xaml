<Window x:Class="MCDSaveEdit.UI.GameAssetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCDSaveEdit.UI"
        mc:Ignorable="d"
        Title="*Game assets*"
        Background="{DynamicResource Brush.Ground}"
        Foreground="{DynamicResource Brush.Text}"
        Height="640" Width="940"
        WindowStyle="ThreeDBorderWindow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <DockPanel Margin="12">

        <!-- Why anybody would want a list of paths. -->
        <TextBlock x:Name="howLabel" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12"
                   Margin="2,0,2,10" Foreground="{DynamicResource Brush.TextMuted}"/>

        <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label x:Name="searchLabel" Grid.Column="0" Content="*Search*" VerticalAlignment="Center"
                   Padding="0,0,8,0"/>
            <TextBox x:Name="searchBox" Grid.Column="1" VerticalAlignment="Center" Padding="4,3"
                     TextChanged="searchBox_TextChanged"/>
            <ComboBox x:Name="kindBox" Grid.Column="2" Width="150" Margin="8,0,0,0"
                      VerticalAlignment="Center" SelectionChanged="kindBox_SelectionChanged"/>
            <TextBlock x:Name="countLabel" Grid.Column="3" VerticalAlignment="Center"
                       Margin="12,0,2,0" FontSize="12"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
        </Grid>

        <!-- What is selected, and the two things worth doing to it. -->
        <Grid DockPanel.Dock="Bottom" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBox x:Name="pathBox" IsReadOnly="True" Padding="4,3" FontFamily="Consolas"
                         Background="{DynamicResource Brush.Surface}"
                         Foreground="{DynamicResource Brush.Text}"/>
                <TextBlock x:Name="statusLabel" Margin="2,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </StackPanel>

            <Button x:Name="copyPathButton" Grid.Column="1" Content="*Copy path*" Padding="10,5"
                    Margin="8,0,0,0" VerticalAlignment="Top" Click="copyPathButton_Click"/>
            <Button x:Name="copyFolderButton" Grid.Column="2" Content="*Copy folder*" Padding="10,5"
                    Margin="6,0,0,0" VerticalAlignment="Top" Click="copyFolderButton_Click"/>
        </Grid>

        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource Brush.Surface}" Margin="2,0,2,0">
            <ListView x:Name="list" BorderThickness="0" Background="Transparent"
                      Foreground="{DynamicResource Brush.Text}"
                      SelectionChanged="list_SelectionChanged"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="kindColumn" Header="*Kind*" Width="130"
                                        DisplayMemberBinding="{Binding Kind}"/>
                        <GridViewColumn x:Name="pathColumn" Header="*Path*" Width="740"
                                        DisplayMemberBinding="{Binding EnginePath}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
