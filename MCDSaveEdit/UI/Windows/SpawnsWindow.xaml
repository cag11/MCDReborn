<Window x:Class="MCDSaveEdit.UI.SpawnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:MCDSaveEdit.UI"
        mc:Ignorable="d"
        Title="*Spawns*"
        Height="900" Width="1560" MinHeight="600" MinWidth="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}">

    <DockPanel Margin="10">

        <TextBlock x:Name="statusLabel" DockPanel.Dock="Bottom" Margin="2,8,2,0"
                   FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Brush.TextMuted}"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="2,10,2,0">
            <Button x:Name="saveButton" Content="*Save*" Padding="14,6" Margin="0,0,8,0"
                    Click="saveButton_Click"/>
            <Button x:Name="revertButton" Content="*Reload*" Padding="12,6" Margin="0,0,8,0"
                    Click="revertButton_Click"/>
            <Button x:Name="installButton" Content="*Install*" Padding="14,6"
                    Click="installButton_Click"/>
            <Button x:Name="wiringButton" Content="*Wiring*" Padding="14,6" Margin="8,0,0,0"
                    Click="wiringButton_Click"/>
            <TextBlock x:Name="changedLabel" VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>

        <!-- The rooms, in the order the mission plays them. Not a file listing: the whole point
             is knowing where you are in the level. -->
        <DockPanel x:Name="roomsPanel" DockPanel.Dock="Left" Width="300" Margin="0,0,10,0">
            <Label x:Name="roomsLabel" DockPanel.Dock="Top" Content="*Rooms*"
                   Style="{StaticResource SectionHeading}" Padding="0,0,0,6"/>
            <ListBox x:Name="roomList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="roomList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>

        <!-- The placement controls, beside the map rather than on top of it. -->
        <Border DockPanel.Dock="Right" Width="290" Margin="10,0,0,0" Padding="12"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4">

            <!-- Scrolls, because this panel now holds six sections and the window is whatever
                 height the screen allows. What fell off the bottom was the mob list, which is
                 the thing most people open this window for. -->
            <TabControl x:Name="panelTabs" Background="Transparent"
                        BorderThickness="0" Padding="0">

                <!-- Where the headers are laid out is decided by the app's TabControl template
                     in Theme/Controls.xaml, not here: a template that names its own items host
                     ignores ItemsPanel entirely, which is why setting it here did nothing. -->

                <TabItem x:Name="mobsTab">
                    <ScrollViewer x:Name="mobsTabScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,8,6,0">
                        <StackPanel>
                        <Label x:Name="placeLabel" Content="*Place spawn points*"
                               Style="{StaticResource SectionHeading}" Padding="0,0,0,4"/>

                        <TextBlock x:Name="placeHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>

                        <TextBlock x:Name="roomLabel" FontWeight="SemiBold" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="x" Grid.Row="0" Grid.Column="0" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Text="y" Grid.Row="0" Grid.Column="1" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Text="z" Grid.Row="0" Grid.Column="2" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>

                            <TextBox x:Name="xBox" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" Height="26"
                                     VerticalContentAlignment="Center"/>
                            <TextBox x:Name="yBox" Grid.Row="1" Grid.Column="1" Margin="0,0,4,0" Height="26"
                                     VerticalContentAlignment="Center"/>
                            <TextBox x:Name="zBox" Grid.Row="1" Grid.Column="2" Height="26"
                                     VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="radiusLabel" Text="*radius*" Grid.Row="0" Grid.Column="0"
                                       FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock x:Name="countLabel" Text="*count*" Grid.Row="0" Grid.Column="1"
                                       FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>

                            <TextBox x:Name="radiusBox" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0"
                                     Height="26" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="countBox" Grid.Row="1" Grid.Column="1" Height="26"
                                     VerticalContentAlignment="Center"/>
                        </Grid>

                        <ComboBox x:Name="tagBox" Margin="0,0,0,10" Height="26" VerticalContentAlignment="Center"/>

                        <!-- Wrapping, not a row. Four buttons do not fit this panel's width and the
                             fourth simply vanished off the edge, which looks like a button that failed
                             to draw rather than one there was no room for. -->
                        <WrapPanel x:Name="actionPanel" Margin="0,0,0,12">
                            <Button x:Name="placeButton" Content="*Place*" Padding="14,5"
                                    Margin="0,0,6,6" Click="placeButton_Click"/>
                            <Button x:Name="removeButton" Content="*Remove point*" Padding="10,5"
                                    Margin="0,0,6,6" Click="removeButton_Click"/>
                            <Button x:Name="clearButton" Content="*Clear room*" Padding="10,5"
                                    Margin="0,0,0,6" Click="clearButton_Click"/>
                        </WrapPanel>

                            <Separator Margin="0,4,0,10"/>

                        <Label x:Name="rulesLabel" Content="*What spawns*"
                               Style="{StaticResource SectionHeading}" Padding="0,0,0,4"/>
                        <TextBlock x:Name="rulesHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>

                        <ComboBox x:Name="groupBox" Margin="0,0,0,8" Height="26"
                                  VerticalContentAlignment="Center"
                                  ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"
                                  SelectionChanged="groupBox_SelectionChanged"/>

                        <TextBlock x:Name="mobsLabel" FontSize="11" Margin="0,4,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>

                        <StackPanel x:Name="mobStack"/>

                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="addMobButton" Content="*Add mob*" Padding="10,4"
                                    Margin="0,0,6,0" Click="addMobButton_Click"/>
                            <Button x:Name="addGroupButton" Content="*New group*" Padding="10,4"
                                    Click="addGroupButton_Click"/>
                        </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="waysTab">
                    <ScrollViewer x:Name="waysTabScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,8,6,0">
                        <StackPanel>

                        <Label x:Name="startsLabel" Content="*Where you come in*"
                               Style="{StaticResource SectionHeading}" Padding="0,0,0,4"/>
                        <TextBlock x:Name="startsHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ListBox x:Name="startsList" MaxHeight="80" Margin="0,0,0,6"
                                 SelectionChanged="startsList_SelectionChanged"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="addStartButton" Content="*Put the start here*" Padding="10,4"
                                    Margin="0,0,6,6" Click="addStartButton_Click"/>
                            <Button x:Name="mainStartButton" Content="*Make this the main way in*" Padding="10,4"
                                    Margin="0,0,6,6" Click="mainStartButton_Click"/>
                            <Button x:Name="removeStartButton" Content="*Remove start*" Padding="10,4"
                                    Margin="0,0,0,6" Click="removeStartButton_Click"/>
                        </WrapPanel>

                            <Separator Margin="0,4,0,10"/>

                        <Label x:Name="exitsLabel" Content="*The way out*"
                               Style="{StaticResource SectionHeading}" Padding="0,0,0,4"/>
                        <TextBlock x:Name="exitsHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ListBox x:Name="exitsList" MaxHeight="80" Margin="0,0,0,6"
                                 SelectionChanged="exitsList_SelectionChanged"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="addExitButton" Content="*Put the exit gate here*" Padding="10,4"
                                    Margin="0,0,6,6" Click="addExitButton_Click"/>
                            <Button x:Name="removeExitButton" Content="*Remove gate*" Padding="10,4"
                                    Margin="0,0,0,6" Click="removeExitButton_Click"/>
                        </WrapPanel>

                            <Separator Margin="0,4,0,10"/>

                        <Label x:Name="doorsLabel" Content="*Doors*"
                               Style="{StaticResource SectionHeading}" Padding="0,0,0,4"/>
                        <TextBlock x:Name="doorsHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ListBox x:Name="doorsList" MaxHeight="120" Margin="0,0,0,6"
                                 SelectionChanged="doorsList_SelectionChanged"/>
                        <TextBox x:Name="doorNameBox" Height="26" Margin="0,0,0,6"
                                 VerticalContentAlignment="Center"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="addDoorButton" Content="*Add door*" Padding="10,4"
                                    Margin="0,0,6,6" Click="addDoorButton_Click"/>
                            <Button x:Name="removeDoorButton" Content="*Remove door*" Padding="10,4"
                                    Margin="0,0,6,6" Click="removeDoorButton_Click"/>
                            <Button x:Name="entryDoorButton" Content="*Make the way in*" Padding="10,4"
                                    Margin="0,0,0,6" Click="entryDoorButton_Click"/>
                        </WrapPanel>

                            <Separator Margin="0,4,0,10"/>

                        <Label x:Name="waysLabel" Content="*Ways in and out*"
                               Style="{StaticResource SectionHeading}" Padding="0,0,0,4"/>
                        <TextBlock x:Name="waysHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ItemsControl x:Name="waysList" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Margin="0,0,0,3"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Text}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="questTab">
                    <ScrollViewer x:Name="questTabScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,8,6,0">
                        <StackPanel>

                        <Label x:Name="questLabel" Content="*What the mission asks*"
                               Style="{StaticResource SectionHeading}" Padding="0,0,0,4"/>
                        <TextBlock x:Name="questHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ListBox x:Name="questList" MaxHeight="120" Margin="0,0,0,6"
                                 SelectionChanged="questList_SelectionChanged"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="onlyExitButton" Content="*Keep only the way out*" Padding="10,4"
                                    Margin="0,0,6,6" Click="onlyExitButton_Click"/>
                            <Button x:Name="removeQuestButton" Content="*Remove step*" Padding="10,4"
                                    Margin="0,0,0,6" Click="removeQuestButton_Click"/>
                        </WrapPanel>

                        <Label x:Name="addStepLabel" Content="*Add a step*"
                               Style="{StaticResource SectionHeading}" Padding="0,0,0,4"/>
                        <TextBlock x:Name="stepWordingWhy" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock x:Name="stepBannerLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBox x:Name="stepBannerSay" Margin="0,0,0,4" Height="26"
                                 VerticalContentAlignment="Center"/>
                        <ComboBox x:Name="stepBannerBox" Margin="0,0,0,8" Height="24"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="borrowWording_Changed"/>

                        <TextBlock x:Name="stepWordingLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBox x:Name="stepSay" Margin="0,0,0,4" Height="26"
                                 VerticalContentAlignment="Center"/>
                        <ComboBox x:Name="stepTitleBox" Margin="0,0,0,8" Height="24"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="borrowWording_Changed"/>
                        <TextBlock x:Name="stepThingLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="stepThingBox" Margin="0,0,0,6" Height="26"
                                  VerticalContentAlignment="Center"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="addClickStepButton" Content="*Click a thing*" Padding="10,4"
                                    Margin="0,0,6,6" Click="addClickStepButton_Click"/>
                            <Button x:Name="addReachStepButton" Content="*Reach a spot*" Padding="10,4"
                                    Margin="0,0,0,6" Click="addReachStepButton_Click"/>
                        </WrapPanel>

                        <Label x:Name="stepsLabel" Content="*The spots those steps use*"
                               Style="{StaticResource SectionHeading}" Padding="0,0,0,4"/>
                        <TextBlock x:Name="stepsHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ListBox x:Name="stepsList" MaxHeight="110" Margin="0,0,0,12"
                                 SelectionChanged="stepsList_SelectionChanged"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="gatesTab">
                    <ScrollViewer x:Name="gatesTabScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,8,6,0">
                        <StackPanel>
                        <TextBlock x:Name="gatesHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ListBox x:Name="gatesList" MaxHeight="150" Margin="0,0,0,6"
                                 SelectionChanged="gatesList_SelectionChanged"/>
                        <WrapPanel Margin="0,0,0,6">
                            <Button x:Name="addGateButton" Content="*Put a gate here*" Padding="10,4"
                                    Margin="0,0,6,6" Click="addGateButton_Click"/>
                            <Button x:Name="turnGateButton" Content="*Turn*" Padding="10,4"
                                    Margin="0,0,6,6" Click="turnGateButton_Click"/>
                            <Button x:Name="widerGateButton" Content="*Wider*" Padding="10,4"
                                    Margin="0,0,6,6" Click="widerGateButton_Click"/>
                            <Button x:Name="narrowerGateButton" Content="*Narrower*" Padding="10,4"
                                    Margin="0,0,6,6" Click="narrowerGateButton_Click"/>
                            <Button x:Name="removeGateRegionButton" Content="*Remove*" Padding="10,4"
                                    Margin="0,0,0,6" Click="removeGateRegionButton_Click"/>
                        </WrapPanel>

                        <Separator Margin="0,4,0,10"/>

                        <TextBlock x:Name="opensLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="opensBox" Margin="0,0,0,6" Height="26"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="drawnLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="drawnBox" Margin="0,0,0,4" Height="26"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="drawnWhy" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="lockGateButton" Content="*This opens it*" Padding="10,4"
                                    Margin="0,0,6,0" Click="lockGateButton_Click"/>
                            <Button x:Name="unlockGateButton" Content="*Nothing opens it*" Padding="10,4"
                                    Click="unlockGateButton_Click"/>
                        </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="arenaTab">
                    <ScrollViewer x:Name="arenaTabScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,8,6,0">
                        <StackPanel>
                        <TextBlock x:Name="arenaHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ListBox x:Name="arenaList" MaxHeight="150" Margin="0,0,0,6"
                                 SelectionChanged="arenaList_SelectionChanged"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="addArenaButton" Content="*Put a fight here*" Padding="10,4"
                                    Margin="0,0,6,6" Click="addArenaButton_Click"/>
                            <Button x:Name="waveArenaButton" Content="*Add a wave*" Padding="10,4"
                                    Margin="0,0,6,6" Click="waveArenaButton_Click"/>
                            <Button x:Name="removeArenaButton" Content="*Remove*" Padding="10,4"
                                    Margin="0,0,0,6" Click="removeArenaButton_Click"/>
                        </WrapPanel>

                        <Separator Margin="0,4,0,10"/>

                        <TextBlock x:Name="arenaWordingLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="arenaWordingBox" Margin="0,0,0,6" Height="26"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="arenaGroupLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="arenaGroupBox" Margin="0,0,0,6" Height="26"
                                  VerticalContentAlignment="Center"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="arenaCountLabel" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBox x:Name="arenaCountBox" Height="26" Text="8"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="arenaRewardLabel" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <ComboBox x:Name="arenaRewardBox" Height="26"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="arenaGateBox" Margin="0,4,0,10" IsChecked="True"
                                  Content="*Seal it while the fight is on*"/>
                        <Button x:Name="applyArenaButton" Content="*Apply to the chosen fight*"
                                Padding="10,4" Margin="0,0,0,12" HorizontalAlignment="Left"
                                Click="applyArenaButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="challengeTab">
                    <ScrollViewer x:Name="challengeTabScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,8,6,0">
                        <StackPanel>
                        <TextBlock x:Name="challengeWhy" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock x:Name="challengeHint" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ListBox x:Name="challengeList" MaxHeight="150" Margin="0,0,0,6"
                                 SelectionChanged="challengeList_SelectionChanged"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="addChallengeButton" Content="*Put a challenge here*"
                                    Padding="10,4" Margin="0,0,6,6" Click="addChallengeButton_Click"/>
                            <Button x:Name="waveChallengeButton" Content="*Add a wave*"
                                    Padding="10,4" Margin="0,0,6,6" Click="waveChallengeButton_Click"/>
                            <Button x:Name="removeChallengeButton" Content="*Remove*"
                                    Padding="10,4" Margin="0,0,0,6" Click="removeChallengeButton_Click"/>
                        </WrapPanel>

                        <Separator Margin="0,4,0,10"/>

                        <TextBlock x:Name="challengeTriggerLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="challengeTriggerBox" Margin="0,0,0,6" Height="26"
                                  VerticalContentAlignment="Center"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="challengeGroupLabel" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <ComboBox x:Name="challengeGroupBox" Height="26"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="challengeCountLabel" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBox x:Name="challengeCountBox" Height="26" Text="6"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="challengeRewardLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="challengeRewardBox" Margin="0,0,0,6" Height="26"
                                  VerticalContentAlignment="Center"/>

                        <TextBlock x:Name="challengeSealsLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="challengeSealsBox" Margin="0,0,0,4" Height="26"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="challengeSealsWhy" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>

                        <Button x:Name="applyChallengeButton" Content="*Apply to the chosen challenge*"
                                Padding="10,4" Margin="0,0,0,12" HorizontalAlignment="Left"
                                Click="applyChallengeButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="keysTab">
                    <ScrollViewer x:Name="keysTabScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,8,6,0">
                        <StackPanel>
                        <TextBlock x:Name="keysHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ListBox x:Name="keysList" MaxHeight="150" Margin="0,0,0,6"
                                 SelectionChanged="keysList_SelectionChanged"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="addKeyedButton" Content="*Put a locked door here*" Padding="10,4"
                                    Margin="0,0,6,6" Click="addKeyedButton_Click"/>
                            <Button x:Name="alsoKeyButton" Content="*The key could also be here*" Padding="10,4"
                                    Margin="0,0,6,6" Click="alsoKeyButton_Click"/>
                            <Button x:Name="removeKeyedButton" Content="*Remove*" Padding="10,4"
                                    Margin="0,0,0,6" Click="removeKeyedButton_Click"/>
                        </WrapPanel>

                        <Separator Margin="0,4,0,10"/>

                        <TextBlock x:Name="keyWordingLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="keyWordingBox" Margin="0,0,0,6" Height="26"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="keyDoorLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="keyDoorBox" Margin="0,0,0,12" Height="26"
                                  VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="levelTab">
                    <ScrollViewer x:Name="levelTabScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,8,6,0">
                        <StackPanel>
                        <TextBlock x:Name="levelHint" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>

                        <TextBlock x:Name="ambienceLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="ambienceBox" Margin="0,0,0,8" Height="26"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="levelSetting_Changed"/>

                        <TextBlock x:Name="musicLabel" FontSize="11" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox x:Name="musicBox" Margin="0,0,0,8" Height="26"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="levelSetting_Changed"/>

                        <CheckBox x:Name="matchDoorsBox" Margin="0,6,0,8"
                                  Content="*Joined tiles must have matching doors*"
                                  Click="levelFlag_Changed"/>
                        <TextBlock x:Name="matchDoorsWhy" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>

                        <CheckBox x:Name="introBox" Margin="0,0,0,12"
                                  Content="*Play the mission intro*"
                                  Click="levelFlag_Changed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

        <!-- The mission itself. Drag to turn it, shift-drag or right-drag to slide it about,
             wheel to come closer, click the ground to say where a spawn point goes. -->
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4"
                Background="#FF101216" ClipToBounds="True">
            <Grid>
                <ui:MapView3D x:Name="mapView"/>

                <TextBlock x:Name="busyLabel" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource Brush.TextMuted}"/>

                <!-- Over the view rather than beside it: the map wants every pixel it can get. -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                        Padding="8,6" CornerRadius="4" Background="#CC1A1D23">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="frameButton" Content="*Fit*" Padding="9,3" Margin="0,0,5,0"
                                Click="frameButton_Click"/>
                        <Button x:Name="overheadButton" Content="*Top down*" Padding="9,3"
                                Click="overheadButton_Click"/>

                        <TextBlock x:Name="ceilingLabel" VerticalAlignment="Center"
                                   Margin="14,0,6,0" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <Slider x:Name="ceilingSlider" Width="150" VerticalAlignment="Center"
                                Minimum="4" Maximum="255" Value="255"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Thumb.DragCompleted="ceilingSlider_DragCompleted"
                                ValueChanged="ceilingSlider_ValueChanged"/>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                        Padding="8,5" CornerRadius="4" Background="#CC1A1D23">
                    <TextBlock x:Name="whereLabel" FontSize="11" FontFamily="Consolas"
                               Foreground="{DynamicResource Brush.Text}"/>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</Window>
