<Window x:Class="MCDSaveEdit.UI.WiringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="*Wiring*"
        Height="900" Width="1500" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}">

    <DockPanel>

        <!-- What is on screen. The readout is deliberately "drawn / shown of total": on a game
             mission the first number says how much of this relationship the level actually has,
             and the gap between the other two says how much of it is still unwired. -->
        <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border}">
            <DockPanel>
                <Button x:Name="arrangeButton" DockPanel.Dock="Right" Padding="12,4"
                        Margin="6,0,0,0" Content="*Arrange*" Click="arrangeButton_Click"/>
                <Button x:Name="fitButton" DockPanel.Dock="Right" Padding="12,4"
                        Content="*Fit*" Click="fitButton_Click"/>
                <CheckBox x:Name="showAllBox" DockPanel.Dock="Right" Margin="0,0,14,0"
                          VerticalAlignment="Center" Content="*show all*"
                          Checked="showAll_Changed" Unchecked="showAll_Changed"/>
                <TextBlock x:Name="whereLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="0,0,16,0" FontWeight="SemiBold"/>
                <TextBlock x:Name="countLabel" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </DockPanel>
        </Border>

        <!-- One tab per relationship. A tab is not a filter over a drawing of the whole level -
             it IS the drawing: it holds what can send that wire and what can take it, and
             nothing else, because nothing else is on screen to connect to. -->
        <Border DockPanel.Dock="Top" Padding="6,0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="tabsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="statusLabel" DockPanel.Dock="Bottom" Margin="10,6"
                   FontSize="12" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Brush.TextMuted}"/>

        <!-- The inspector. Deliberately narrow: it names what is selected and what file field it
             writes, and does not try to be the editor - the tabs in the Spawns window already
             are, and two ways to change one thing is how they disagree. -->
        <Border DockPanel.Dock="Right" Width="270" Padding="12" BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource Brush.Border}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="detailPanel"/>
            </ScrollViewer>
        </Border>

        <Border x:Name="stage" ClipToBounds="True" Background="{DynamicResource Brush.Panel}"
                MouseLeftButtonDown="stage_Down" MouseMove="stage_Move"
                MouseLeftButtonUp="stage_Up" MouseWheel="stage_Wheel"
                Focusable="True" KeyDown="stage_Key">
            <Canvas x:Name="sheet">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="zoom" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="pan"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>
        </Border>

    </DockPanel>
</Window>
