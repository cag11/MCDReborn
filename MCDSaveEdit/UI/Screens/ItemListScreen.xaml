<UserControl x:Class="MCDSaveEdit.UI.ItemListScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCDSaveEdit.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="350">
        <DockPanel Margin="0" Width="350">
            <Grid DockPanel.Dock="Top" Height="35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="allItemsButton" Content="*All*" Margin="4" Click="allItemsButton_Click" Background="{x:Null}"/>
                <Button Grid.Column="1" x:Name="meleeItemsButton" Content="*Melee*" Margin="4" Click="allMeleeItemsButton_Click" Background="{x:Null}"/>
                <Button Grid.Column="2" x:Name="rangedItemsButton" Content="*Ranged*" Margin="4" Click="allRangedItemsButton_Click" Background="{x:Null}"/>
                <Button Grid.Column="3" x:Name="armorItemsButton" Content="*Armor*" Margin="4" Click="allArmorItemsButton_Click" Background="{x:Null}"/>
                <Button Grid.Column="4" x:Name="artifactItemsButton" Content="*Artifacts*" Margin="4" Click="allArtifactItemsButton_Click" Background="{x:Null}"/>
                <Button Grid.Column="5" x:Name="enchantedItemsButton" Content="*Enchanted*" Margin="4" Click="allEnchantedItemsButton_Click" Background="{x:Null}"/>
            </Grid>

            <!--
                Deliberately slim and quiet: one 24px row under the category filters rather
                than a banner. The match count only appears while a search is active, so at
                rest this adds a single empty field and nothing else.
            -->
            <Grid DockPanel.Dock="Top" Height="24" Margin="4,0,4,4">
                <TextBox x:Name="itemSearchBox" FontSize="12" Padding="6,1"
                         VerticalContentAlignment="Center"
                         TextChanged="itemSearchBox_TextChanged"/>
                <TextBlock x:Name="itemSearchHint" Text="Search items…" Margin="8,0,0,0"
                           FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.TextDisabled}"/>
                <TextBlock x:Name="itemSearchCountLabel" Text="" Margin="0,0,8,0"
                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </Grid>

            <!--
                The bottom bar does double duty: the slot count at rest, and the delete bar while
                items are being picked. One bar rather than two, because the count and the delete
                controls are never both wanted, and a 350px column has no room to spare.
            -->
            <Grid DockPanel.Dock="Bottom" Height="35" HorizontalAlignment="Stretch" Margin="0">
                <Grid x:Name="countBar">
                    <Label x:Name="inventoryCountLabel" Content="*Items: 130/180 Max*" HorizontalContentAlignment="Center"/>
                    <Button x:Name="deleteModeButton" Content="*Delete items*" FontSize="11" Padding="8,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Height="22" Margin="0,0,6,0"
                            Click="deleteModeButton_Click"/>
                </Grid>

                <Grid x:Name="deleteBar" Visibility="Collapsed" Margin="6,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="deleteCancelButton" Content="*Cancel*" FontSize="11" Padding="7,0"
                                Height="22" Margin="0,0,4,0" Click="deleteCancelButton_Click"/>
                        <Button x:Name="deleteSelectAllButton" Content="*All*" FontSize="11" Padding="7,0"
                                Height="22" Margin="0,0,6,0" Click="deleteSelectAllButton_Click"/>
                        <TextBlock x:Name="deleteChosenLabel" Text="" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>
                    <Button x:Name="deleteConfirmButton" Content="*Delete*" FontSize="11" Padding="8,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Height="22"
                            Foreground="{DynamicResource Brush.Danger}"
                            Click="deleteConfirmButton_Click"/>
                </Grid>
            </Grid>

            <ScrollViewer DockPanel.Dock="Left" Margin="10" HorizontalAlignment="Stretch">
                <Grid x:Name="itemsGrid" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.Children>
                        <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Height="100" Margin="0" VerticalAlignment="Center" Width="100">
                            <Image Source="../../Images/Unknown.png"/>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Height="100" Margin="0" VerticalAlignment="Center" Width="100">
                            <Image Source="../../Images/Armor.png"/>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" Height="100" Margin="0" VerticalAlignment="Center" Width="100">
                            <Image Source="../../Images/Armor.png"/>
                        </Button>
                    </Grid.Children>
                </Grid>
            </ScrollViewer>

        </DockPanel>

</UserControl>
